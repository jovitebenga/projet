# local: stockage SQLite et fichiers locaux, exclusivement pour le poste de travail.
DATA_BACKEND=local
SITE_URL=http://localhost:3000
# Production : DATA_BACKEND=supabase ; ne pas activer LOCAL_PREVIEW.
LOCAL_PREVIEW=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète serveur pour la réception des demandes et l'import initial uniquement.
SUPABASE_SECRET_KEY=
# Anti-spam Cloudflare Turnstile requis pour le formulaire distant.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_IP_SALT=
